# Copy to .env.local and fill in.
# Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the marketing site. Feeds Next's metadataBase, so Open
# Graph, canonical and JSON-LD URLs, sitemap.xml and robots.txt use it. Unset,
# it's http://localhost:3000 in `next dev` and https://cuberhub.me in a
# production build. Set it to https://cuberhub.me in Vercel production.
NEXT_PUBLIC_SITE_URL=

# The app origin once the hosts are split (docs/app-shell-plan.md). Leave unset
# for one host (previews, local dev); https://app.cuberhub.me at go-live.
# NEXT_PUBLIC_APP_URL=

# Signed-in e2e tests (tests/e2e/auth.setup.ts): two ordinary accounts made in
# Supabase → Authentication → Add user, with Auto Confirm. Specs skip if unset.
# The same four go in GitHub Actions secrets for CI.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# Never put the service_role key in this file or in .env.local.
# It bypasses Row Level Security, and any NEXT_PUBLIC_ variable is
# shipped to the browser. Server-side secrets belong in the hosting
# platform's environment settings, without the NEXT_PUBLIC_ prefix.
